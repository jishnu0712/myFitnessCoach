# Copy this file to .env and replace the example values for your local setup.
# Never commit .env or put production credentials in source control.

# Human-readable API name shown in OpenAPI documentation.
APP_NAME="My Fitness Coach API"
# development, test, or production.
APP_ENV=development
# Enable verbose framework behavior only for local development.
DEBUG=true
# PostgreSQL URL for running the API directly on your computer.
DATABASE_URL=postgresql+asyncpg://fitness_user:change-me@localhost:5432/fitness_db
# Python logging level: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=INFO
# Replace with a unique random value of at least 32 characters in production.
AUTH_SECRET_KEY=development-only-change-this-secret-key
# Access token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional test-account seeder credentials. Replace all placeholders before seeding.
SEED_SUPERADMIN_EMAIL=superadmin@example.test
SEED_SUPERADMIN_PASSWORD=replace-this-superadmin-password
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=replace-this-admin-password
SEED_USER_EMAIL=user@example.test
SEED_USER_PASSWORD=replace-this-user-password

# Compose-only PostgreSQL settings. Use a URL-safe password for the sample DATABASE_URL.
POSTGRES_DB=fitness_db
POSTGRES_USER=fitness_user
POSTGRES_PASSWORD=change-me